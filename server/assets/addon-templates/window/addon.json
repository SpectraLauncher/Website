{
  "id": "my-window",
  "name": "Server watch",
  "version": "1.0.0",
  "description": "A button in the title bar that opens its own window and checks Minecraft servers.",
  "api": 1,
  "launcher": ">=1.0.0",
  "permissions": [
    "servers:ping",
    "network:usespectra.app"
  ],
  "contributes": {
    "windows": [
      {
        "id": "watch",
        "title": "Server watch",
        "entry": "ui/watch.html",
        "width": 420,
        "height": 560
      }
    ],
    "locales": {
      "en": "locales/en.json",
      "pl": "locales/pl.json"
    },
    "buttons": [
      {
        "id": "open-watch",
        "slot": "titlebar",
        "title": "%watch%",
        "icon": "icons/server.svg",
        "action": {
          "type": "window",
          "window": "watch"
        }
      }
    ]
  }
}
